VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Experiment: adapter-switching for Project reads only (see src/adapters/).
# 'supabase' (default) | 'rest' — 'rest' requires backend/rest-api/ running
# and VITE_REST_API_URL set.
VITE_DATA_SOURCE=supabase
VITE_REST_API_URL=http://localhost:8081

# MCP server (backend/mcp-server/cmd-http) endpoint — used only to generate the
# "Copy Setup Prompt" text in Project Settings > Agent Tokens. Not required for the
# app to run; leave unset until the MCP server is actually deployed somewhere.
VITE_MCP_SERVER_URL=http://localhost:8082/mcp
