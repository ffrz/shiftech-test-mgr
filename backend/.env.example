# Copy to .env (gitignored) and fill in real values. Never commit real credentials.

# Supabase Postgres connection string. Direct connection (db.<ref>.supabase.co:5432)
# is IPv6-only and may not be reachable from your machine — if so, use the
# Session pooler string instead (Supabase Dashboard > Project Settings > Database
# > Connection string > Session pooler): postgresql://postgres.<ref>@aws-<N>-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.pgyuxtwzhflzujhrxixl.supabase.co:5432/postgres

# --- mcp-server/cmd only (stdio, dev lokal — one process = one client) ---
TM_API_TOKEN=tm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TM_PROJECT_ID=00000000-0000-0000-0000-000000000000
TM_MCP_READONLY=1

# --- mcp-server/cmd-http only (HTTP, deploy VPS — token/project dikirim
# per-request lewat header Authorization/X-Testify-Project-Id, bukan di sini) ---
# HTTP_PORT=8082

# --- rest-api only ---
HTTP_PORT=8081
