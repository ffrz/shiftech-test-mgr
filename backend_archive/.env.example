APP_ENV=development
LOG_LEVEL=info

HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=10s

# mysql | postgres — switch driver, restart process, done. No rebuild needed.
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=testmgr
DB_PASSWORD=testmgr
DB_NAME=testmgr
# postgres only ("disable" | "require"); ignored when DB_DRIVER=mysql
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

JWT_SECRET=change-me-to-a-long-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback
